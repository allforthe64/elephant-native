{
  "cli": {
    "version": ">= 9.0.6"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_TEST_EMAIL": "myelephanttesting@gmail.com",
        "EXPO_PUBLIC_TEST_PASSWORD": "myelephanttest1234",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "testlab": {
      "extends": "preview",
      "env": {
        "EXPO_PUBLIC_DISABLE_APP_CHECK": "true",
        "EXPO_PUBLIC_TEST_EMAIL": "myelephanttesting@gmail.com",
        "EXPO_PUBLIC_TEST_PASSWORD": "myelephanttest1234",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ALLOW_FAILURE": "true"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "SENTRY_ALLOW_FAILURE": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "williamhrainey@gmail.com",
        "ascAppId": "6502719050",
        "appleTeamId": "F3L6F75CJY"
      }
    }
  }
}
